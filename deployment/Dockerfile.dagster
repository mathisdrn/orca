FROM python:3.13-slim

# Install uv for fast Python environment setup
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy project metadata and README required by hatchling build backend
COPY pyproject.toml uv.lock README.md ./

# Copy application source code
COPY ingestion/ ./ingestion/
COPY transformation/ ./transformation/
COPY orchestration/ ./orchestration/
COPY storage/ ./storage/
COPY deployment/proxy_guard.py ./deployment/proxy_guard.py

# Install dependencies using Python 3.13
RUN uv sync --frozen --no-dev --python 3.13

# Pre-compile dbt manifest so Dagster webserver initializes instantly without runtime compilation
RUN cd transformation && uv run --python 3.13 dbt compile --threads 1

ENV DAGSTER_HOME=/app/orchestration/dagster_home
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD uv run --python 3.13 dagster-webserver -h 127.0.0.1 -p 8081 -f orchestration/definitions.py --path-prefix /orchestration --read-only & TARGET_PORT=8081 python3 deployment/proxy_guard.py
