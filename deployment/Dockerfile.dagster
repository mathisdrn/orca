FROM python:3.13-slim

# Install uv for fast Python environment setup
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Enable native bytecode compilation in uv & set virtual environment PATH
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    DAGSTER_HOME=/app/orchestration/dagster_home \
    PYTHONUNBUFFERED=1

# 1. Copy dependency files first to maximize Docker layer cache
COPY pyproject.toml uv.lock README.md ./

# 2. Install third-party dependencies first (without project source)
RUN uv sync --frozen --no-dev --no-install-project --python 3.13

# 3. Copy application source code (changes here reuse cached dependency layer)
COPY ingestion/ ./ingestion/
COPY transformation/ ./transformation/
COPY orchestration/ ./orchestration/
COPY storage/ ./storage/

# 4. Install the project package itself & clean uv build cache to minimize image size
RUN uv sync --frozen --no-dev --python 3.13 && uv cache clean

# 5. Pre-compile dbt manifest
RUN cd transformation && dbt compile --threads 1

EXPOSE 8080

CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "8080", "-f", "orchestration/definitions.py", "--path-prefix", "/orchestration", "--read-only"]
