FROM python:3.12-slim

# Install uv for fast Python environment setup
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy project metadata and README required by hatchling build backend
COPY pyproject.toml uv.lock README.md ./

# Copy application source code
COPY ingestion/ ./ingestion/
COPY transformation/ ./transformation/
COPY orchestration/ ./orchestration/
COPY storage/ ./storage/

# Install dependencies using Python 3.12
RUN uv sync --frozen --no-dev --python 3.12

# Pre-compile dbt manifest so Dagster webserver initializes instantly without runtime compilation
RUN cd transformation && uv run --python 3.12 dbt compile --threads 1

ENV DAGSTER_HOME=/app/orchestration/dagster_home
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["uv", "run", "--python", "3.12", "dagster-webserver", "-h", "0.0.0.0", "-p", "8080", "-f", "orchestration/definitions.py", "--path-prefix", "/orchestration", "--read-only"]
