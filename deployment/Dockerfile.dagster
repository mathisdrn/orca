FROM python:3.13-slim

# Install uv for fast Python environment setup
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Minimal OS packages for SSL and curl
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Enable native bytecode compilation in uv & set virtual environment PATH
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONOPTIMIZE=1 \
    PATH="/app/.venv/bin:$PATH" \
    DAGSTER_HOME=/app/orchestration/dagster_home \
    PYTHONUNBUFFERED=1

# 1. Copy dependency files first to maximize Docker layer cache
COPY pyproject.toml uv.lock README.md ./

# 2. Install third-party dependencies first (without project source)
RUN uv sync --frozen --no-dev --no-install-project --python 3.13

# 3. Copy application source code (changes here reuse cached dependency layer)
COPY ingestion/ ./ingestion/
COPY transformation/ ./transformation/
COPY orchestration/ ./orchestration/
COPY analytics/ ./analytics/
COPY storage/ ./storage/

# 4. Install the project package itself & clean uv build cache to minimize image size
RUN mkdir -p /app/orchestration/dagster_home && uv sync --frozen --no-dev --python 3.13 && uv cache clean

# 5. Pre-compile dbt manifest & Malloy AST manifest
RUN cd transformation && dbt compile --threads 1
RUN python analytics/build_manifest.py

EXPOSE 8080

CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "8080", "-f", "orchestration/definitions.py", "--path-prefix", "/orchestration", "--read-only", "--suppress-warnings", "--uvicorn-log-level", "warning", "--live-data-poll-rate", "600000", "--code-server-log-level", "WARNING"]
