FROM python:3.12-slim

# Install uv for fast Python environment setup
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy project metadata and README required by hatchling build backend
COPY pyproject.toml uv.lock README.md ./

# Copy application source code for workspace package build
COPY ingestion/ ./ingestion/
COPY transformation/ ./transformation/
COPY orchestration/ ./orchestration/
COPY storage/ ./storage/

RUN uv sync --frozen --no-dev

ENV DAGSTER_HOME=/app/orchestration/dagster_home
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["uv", "run", "dagster-webserver", "-h", "0.0.0.0", "-p", "8080", "-f", "orchestration/definitions.py", "--path-prefix", "/orchestration", "--read-only"]
